{
  "name": "aerodesign-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Jogo de gestão de equipe universitária de aerodesign, inspirado na competição brasileira",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
